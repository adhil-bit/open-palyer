{
  "name": "open-player-desktop",
  "productName": "Open Player",
  "version": "1.6.0",
  "description": "Open Player for Linux, Windows and Mac: an ad-free video and music player with an FFmpeg engine",
  "license": "GPL-3.0-or-later",
  "author": "Open Player <adhil-bit@users.noreply.github.com>",
  "homepage": "https://github.com/adhil-bit/open-palyer",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-www": "node build.mjs",
    "start": "npm run prepare-www && electron .",
    "dist": "npm run prepare-www && electron-builder --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "hls.js": "1.7.4"
  },
  "build": {
    "appId": "io.github.adhilbit.openplayer",
    "productName": "Open Player",
    "artifactName": "OpenPlayer-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "www/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mkv",
          "webm",
          "mov",
          "avi",
          "flv",
          "ts",
          "m2ts",
          "mts",
          "mpg",
          "mpeg",
          "vob",
          "wmv",
          "3gp",
          "ogv"
        ],
        "name": "Video",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "aac",
          "flac",
          "wav",
          "ogg",
          "opus",
          "ac3",
          "dts",
          "wma"
        ],
        "name": "Audio",
        "role": "Viewer"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "www/icons/icon-512.png",
      "maintainer": "Open Player <adhil-bit@users.noreply.github.com>",
      "synopsis": "Ad-free video and music player"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "www/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "www/icons/icon-512.png",
      "identity": null
    },
    "publish": []
  }
}
